# Ishtaxa sozlamalari. Bu faylni .env nomi bilan nusxalab, qiymatlarni oʻzgartiring.
# Hosting panelida bularni "Environment variables" boʻlimiga kiritasiz.

NODE_ENV=production
PORT=3000

# Admin sahifasining YASHIRIN manzili. Albatta oʻzgartiring (faqat harf, raqam, - va _).
# Masalan: /boshqaruv-q7x2m9  ->  https://saytingiz.uz/boshqaruv-q7x2m9
ADMIN_PATH=/boshqaruv-OZGARTIRING

# Admin login. Parol ixtiyoriy: bermasangiz, birinchi ishga tushganda tasodifiy parol
# yaratiladi va serverning logida BIR MARTA koʻrsatiladi.
ADMIN_USER=admin
# ADMIN_PASSWORD=kamida-10-belgi-harf-va-raqam

# Sayt HTTPS orqali proksi (Render, Railway, Nginx va h.k.) ortida ishlasa — 1 qiling.
TRUST_PROXY=1

# Ma'lumotlar bazasi fayli. Hostingda DOIMIY disk (volume) tomon yoʻnaltiring, masalan /data/ishtaxa.db
DB_FILE=/data/ishtaxa.db
